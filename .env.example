# =====================================================
# DJ GooD OFF FM - Environment Variables
# =====================================================
# Скопируйте этот файл в .env.local и заполните значения
# cp .env.example .env.local

# =====================================================
# TELEGRAM BOT CONFIGURATION
# =====================================================
# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Chat ID администратора для уведомлений
ADMIN_CHAT_ID=your_telegram_id_here

# Admin User ID для Mini App (опционально, по умолчанию 55068554)
NEXT_PUBLIC_ADMIN_USER_ID=55068554

# =====================================================
# ICECAST / STREAM CONFIGURATION
# =====================================================
# URL Icecast сервера (без /Radio)
ICECAST_URL=http://your-server:8000

# Точка монтирования потока
MOUNT_POINT=Radio

# =====================================================
# CLOUDFLARE WORKERS (опционально)
# =====================================================
# URL Now Playing Worker
NEXT_PUBLIC_NOWPLAYING_URL=https://nowplaying.your-subdomain.workers.dev

# URL Listeners Worker
NEXT_PUBLIC_LISTENERS_URL=https://listeners.your-subdomain.workers.dev
