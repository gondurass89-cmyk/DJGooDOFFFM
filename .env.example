# =====================================================
# DJ GooD OFF FM - Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# =====================================================
# CLOUDFLARE WORKERS (Public - used in browser)
# =====================================================
# These URLs are safe to expose to the client

# Listeners tracking worker (D1 Database)
NEXT_PUBLIC_LISTENERS_WORKER_URL=https://listeners.your-subdomain.workers.dev

# Now playing track worker (D1 Database)
NEXT_PUBLIC_NOWPLAYING_WORKER_URL=https://nowplaying.your-subdomain.workers.dev

# =====================================================
# STREAM SERVER (Server-side only)
# =====================================================
# Internal Icecast stream URL - NOT exposed to client

# Direct Icecast stream URL (used by /api/stream proxy)
STREAM_INTERNAL_URL=http://your-server:8000/Radio

# Icecast status page (fallback for track info)
ICECAST_STATUS_URL=http://your-server:8000/status.xsl

# Mount point for this station
ICECAST_MOUNT_POINT=RH84200

# =====================================================
# TELEGRAM BOT (Server-side only)
# =====================================================
# Get from @BotFather on Telegram

# Bot token for admin notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin chat ID for notifications
TELEGRAM_ADMIN_CHAT_ID=123456789

# =====================================================
# LAST.FM API (Server-side only)
# =====================================================
# Get your API key at: https://www.last.fm/api/account/create

# Last.fm API key for album artwork
LASTFM_API_KEY=your_lastfm_api_key_here
