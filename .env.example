# DJ GooD OFF FM - Environment Variables
# Copy this file to .env.local and fill in your values

# Stream URL (Cloudflare Worker HTTPS proxy for Icecast HTTP stream)
# Deploy the worker from /cloudflare-worker/radio-proxy.js first
NEXT_PUBLIC_STREAM_URL=https://radio-stream.gondurass89.workers.dev

# Last.fm API Key (for album artwork)
# Get your free API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Telegram Bot Token (for listener notifications)
# Already configured in code, but you can override here
# TELEGRAM_BOT_TOKEN=your_bot_token_here
