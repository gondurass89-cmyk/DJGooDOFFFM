# DJ GooD OFF FM - Environment Variables
# Copy this file to .env.local and fill in your values

# Stream URL (Cloudflare Worker HTTPS proxy for Icecast HTTP stream)
# Deploy the worker from /cloudflare-worker/radio-proxy.js first
NEXT_PUBLIC_STREAM_URL=https://radio-stream.gondurass89.workers.dev

# Last.fm API Key (for album artwork)
# Get your free API key at: https://www.last.fm/api/account/create
# Already configured in Vercel as NEXT_PUBLIC_LASTFM_KEY
NEXT_PUBLIC_LASTFM_KEY=your_lastfm_api_key_here

# Upstash Redis (for listener count - serverless friendly)
# Create free account at: https://upstash.com
# Create a Redis database and copy the REST API credentials
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Telegram Bot Configuration
# Your bot username (without @)
NEXT_PUBLIC_BOT_USERNAME=RadioGoodOFF_bot

# Mini App name (the short name you gave your Mini App in BotFather)
# This is used for the share link: https://t.me/bot_username/mini_app_name
# Default is 'app' if not specified
NEXT_PUBLIC_MINI_APP_NAME=app

# Telegram Bot Token (for webhook and notifications)
# Get from @BotFather when you created your bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Cron secret (optional) - for securing the cron endpoint
CRON_SECRET=your_random_secret_here
