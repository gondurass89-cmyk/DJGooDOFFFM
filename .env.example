# =====================================================
# DJ GooD OFF FM - Environment Variables
# =====================================================
# Скопируй этот файл в .env.local и заполни значения

# =====================================================
# TELEGRAM BOT (для уведомлений о слушателях)
# =====================================================
# Получить токен: @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Узнать свой ID: напиши боту @userinfobot в Telegram
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id_here

# =====================================================
# LAST.FM API (для обложек альбомов)
# =====================================================
# Получить API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# =====================================================
# ICECAST STREAM (внутренний URL)
# =====================================================
STREAM_INTERNAL_URL=http://178.49.69.37:8000/Radio
